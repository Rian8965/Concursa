generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTENTICAÇÃO (NextAuth.js v5)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// USUÁRIOS
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(STUDENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  studentProfile StudentProfile?
  firstAccessTokens FirstAccessToken[]
  passwordResetTokens PasswordResetToken[]
  supportTicketsCreated SupportTicket[] @relation("SupportTicketCreatedBy")
  supportTicketsAsUser  SupportTicket[] @relation("SupportTicketUser")

  @@map("users")
}

enum UserRole {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

// ============================================================
// SUPORTE (IA + CHAMADOS) + NOTIFICAÇÕES DO ADMIN
// ============================================================

enum SupportTicketStatus {
  OPEN
  IN_ANALYSIS
  RESPONDED
  RESOLVED
  AUTO_CLOSED
}

enum SupportTicketType {
  ACCESS
  PAYMENT
  QUESTION_ERROR
  USAGE_DOUBT
  TECHNICAL
  OTHER
}

enum SupportMessageActor {
  USER
  ADMIN
  AI
  SYSTEM
}

model SupportTicket {
  id          String               @id @default(cuid())
  protocol    String               @unique
  createdById String
  userId      String?
  studentProfileId String?
  subject     String
  type        SupportTicketType    @default(OTHER)
  status      SupportTicketStatus  @default(OPEN)
  dueAt       DateTime
  respondedAt DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?
  closedReason String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy   User                 @relation("SupportTicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  user        User?                @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: SetNull)
  studentProfile StudentProfile?   @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)
  messages    SupportMessage[]

  @@index([createdById, createdAt])
  @@index([status, updatedAt])
  @@index([dueAt])
  @@map("support_tickets")
}

model SupportMessage {
  id          String             @id @default(cuid())
  ticketId    String
  actor       SupportMessageActor
  actorUserId String?
  content     String             @db.Text
  attachments Json?
  createdAt   DateTime           @default(now())

  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

enum AdminNotificationType {
  SUPPORT_TICKET_CREATED
  QUESTION_REPORTED
  PAYMENT_STUDENT_CREATED
  SYSTEM
}

model AdminNotification {
  id        String                @id @default(cuid())
  type      AdminNotificationType
  title     String
  body      String?               @db.Text
  href      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([readAt, createdAt])
  @@index([type, createdAt])
  @@map("admin_notifications")
}

model StudentProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  planId          String?
  accessExpiresAt DateTime?
  phone           String?
  cpf             String?   @unique
  createdByPayment Boolean  @default(false)
  needsOnboarding  Boolean  @default(false)
  preferredCompetitionId String?
  preferredJobRoleId String?
  preferredJobRoleText String?
  onboardingCompletedAt DateTime?

  // ---- Controle de uso de IA ----
  aiCorrectionsToday       Int       @default(0)
  aiCorrectionsMonth       Int       @default(0)
  aiLastDailyResetAt       DateTime?
  aiLastMonthlyResetAt     DateTime?
  aiBlockedManually        Boolean   @default(false)
  aiDailyLimitOverride     Int?
  aiMonthlyLimitOverride   Int?
  aiEstimatedCostTodayBrl  Float     @default(0)
  aiEstimatedCostMonthBrl  Float     @default(0)
  aiEstimatedCostTotalBrl  Float     @default(0)
  aiLastUsageAt            DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                Plan?                 @relation(fields: [planId], references: [id])
  preferredCompetition Competition?         @relation("StudentPreferredCompetition", fields: [preferredCompetitionId], references: [id])
  preferredJobRole     JobRole?             @relation("StudentPreferredJobRole", fields: [preferredJobRoleId], references: [id])
  studentCompetitions StudentCompetition[]
  studentAnswers      StudentAnswer[]
  aiUsageLogs         AiUsageLog[]
  aiCreditBalance     StudentAiCreditBalance?
  aiCreditTransactions AiCreditTransaction[]
  trainingSessions    TrainingSession[]
  simulatedExams      SimulatedExam[]
  apostilas           Apostila[]
  usedQuestions       UsedQuestion[]
  questionReports     QuestionReport[]
  subscriptions       Subscription[]
  supportTickets      SupportTicket[]

  @@index([createdByPayment])
  @@index([needsOnboarding])
  @@map("student_profiles")
}

// ============================================================
// BILLING / ASSINATURAS (InfinityPay)
// ============================================================

enum PaymentStatus {
  PENDING
  APPROVED
  REFUSED
  CANCELLED
}

model Subscription {
  id               String        @id @default(cuid())
  studentProfileId String
  planId           String
  status           PaymentStatus @default(PENDING)
  startedAt        DateTime?
  cancelledAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  plan           Plan           @relation(fields: [planId], references: [id])
  transactions   PaymentTransaction[]

  @@index([studentProfileId])
  @@index([status])
  @@map("subscriptions")
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  subscriptionId String?
  status         PaymentStatus @default(PENDING)
  amountCents    Int
  paidAmountCents Int?
  installments   Int?
  captureMethod  String?
  receiptUrl     String?       @db.Text

  // InfinityPay identifiers
  handle         String
  orderNsu       String?
  invoiceSlug    String?
  transactionNsu String?

  raw            Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  approvedAt     DateTime?

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([handle, orderNsu])
  @@index([status])
  @@index([invoiceSlug])
  @@index([transactionNsu])
  @@map("payment_transactions")
}

model FirstAccessToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("first_access_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  createdByAdminId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================
// PLANOS DE ACESSO
// ============================================================

model Plan {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  description          String?
  isActive             Boolean  @default(true)
  durationDays         Int?
  features             Json?
  // Preço em centavos (ex: 3990 = R$ 39,90)
  priceCents           Int?
  // Limites de IA
  aiDailyLimit         Int?
  aiMonthlyLimit       Int?
  aiResponseCharLimit  Int?
  // ID do produto/preço no gateway de pagamento
  checkoutProductId    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  students         StudentProfile[]
  planCompetitions PlanCompetition[]
  subscriptions    Subscription[]
  aiUsageLogs      AiUsageLog[]

  @@map("plans")
}

model PlanCompetition {
  planId        String
  competitionId String

  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([planId, competitionId])
  @@map("plan_competitions")
}

// ============================================================
// IA — LOGS, CRÉDITOS EXTRAS E CONFIGURAÇÃO GLOBAL
// ============================================================

enum AiUsageSource {
  plan_quota
  extra_credit
  admin_bonus
  legacy_allowance
}

enum AiCreditTransactionType {
  purchase
  usage
  manual_adjustment
  refund
  admin_bonus
}

/// Registro de cada chamada de IA (Gemini/OpenAI) feita por um aluno
model AiUsageLog {
  id                      String        @id @default(cuid())
  studentProfileId        String
  planId                  String?
  questionId              String?
  usageSource             AiUsageSource @default(plan_quota)
  model                   String?
  inputTokens             Int?
  outputTokens            Int?
  estimatedCostUsd        Float?
  estimatedCostBrl        Float?
  exchangeRateUsed        Float?
  extraCreditBalanceBefore Int?
  extraCreditBalanceAfter  Int?
  status                  String        @default("success")
  errorMessage            String?       @db.Text
  createdAt               DateTime      @default(now())

  studentProfile  StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  plan            Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  question        Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  creditTransactions AiCreditTransaction[]

  @@index([studentProfileId, createdAt])
  @@index([planId])
  @@index([questionId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

/// Pacotes de créditos extras disponíveis para compra
model AiCreditPackage {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  priceBrl           Float
  creditsAmount      Int
  active             Boolean  @default(true)
  checkoutProductId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transactions AiCreditTransaction[]

  @@map("ai_credit_packages")
}

/// Saldo de créditos extras por aluno
model StudentAiCreditBalance {
  id                    String   @id @default(cuid())
  studentProfileId      String   @unique
  availableCredits      Int      @default(0)
  totalPurchasedCredits Int      @default(0)
  totalUsedExtraCredits Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@map("student_ai_credit_balances")
}

/// Histórico de movimentações de créditos extras (compras, usos, bônus admin)
model AiCreditTransaction {
  id                  String                  @id @default(cuid())
  studentProfileId    String
  transactionType     AiCreditTransactionType
  creditsAmount       Int
  balanceBefore       Int
  balanceAfter        Int
  relatedPaymentId    String?
  relatedAiUsageLogId String?
  packageId           String?
  description         String?
  createdAt           DateTime                @default(now())

  studentProfile  StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  aiUsageLog      AiUsageLog?      @relation(fields: [relatedAiUsageLogId], references: [id], onDelete: SetNull)
  package         AiCreditPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([studentProfileId, createdAt])
  @@index([relatedPaymentId])
  @@map("ai_credit_transactions")
}

/// Configuração global de segurança da IA
model AiGlobalConfig {
  id                             String   @id @default(cuid())
  aiEnabled                      Boolean  @default(true)
  globalDailyCallLimit           Int      @default(5000)
  globalDailyCallsUsed           Int      @default(0)
  globalDailyCostLimitBrl        Float    @default(80.0)
  globalDailyCostUsedBrl         Float    @default(0.0)
  globalLastDailyResetAt         DateTime?
  alertThreshold1Brl             Float    @default(20.0)
  alertThreshold2Brl             Float    @default(40.0)
  blockPartialThresholdBrl       Float    @default(60.0)
  pauseAllThresholdBrl           Float    @default(80.0)
  manualBlockUntil               DateTime?
  allowExtraCreditsAboveDailyLimit Boolean @default(false)
  exchangeRateUsdBrl             Float    @default(5.5)
  exchangeRateUpdatedAt          DateTime?
  updatedAt                      DateTime @updatedAt

  @@map("ai_global_config")
}

/// Log de ações administrativas manuais
model AdminActionLog {
  id            String   @id @default(cuid())
  adminUserId   String
  targetUserId  String
  actionType    String
  previousValue Json?
  newValue      Json?
  reason        String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_action_logs")
}

// ============================================================
// ESTRUTURA GEOGRÁFICA E INSTITUCIONAL
// ============================================================

model City {
  id        String   @id @default(cuid())
  name      String
  state     String
  ibgeCode  String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competitions Competition[]
  questions    Question[]
  aiMetas      QuestionAiMeta[]
  importedQuestionRows ImportedQuestion[]

  @@map("cities")
}

model ExamBoard {
  id          String   @id @default(cuid())
  name        String
  acronym     String   @unique
  website     String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competitions Competition[]
  questions    Question[]
  aiMetas      QuestionAiMeta[]
  importedQuestionRows ImportedQuestion[]

  @@map("exam_boards")
}

model JobRole {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  area        String?
  level       String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  competitions        CompetitionJobRole[]
  competitionSubjects CompetitionJobRoleSubject[]
  subjects            JobRoleSubject[]
  studentCompetitions StudentCompetition[]
  preferredByStudents StudentProfile[] @relation("StudentPreferredJobRole")
  questions           Question[]
  aiMetas             QuestionAiMeta[]
  importedQuestionRows ImportedQuestion[]

  @@map("job_roles")
}

// ============================================================
// CONCURSOS
// ============================================================

model Competition {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  cityId           String
  organization     String?
  examBoardId      String?
  examBoardDefined Boolean           @default(false)
  examDate         DateTime?
  status           CompetitionStatus @default(UPCOMING)
  editalUrl        String?
  description      String?
  bannerUrl        String?
  isActive         Boolean           @default(true)
  salesLinkActive  Boolean           @default(false)
  salesLinkVisits  Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  city             City               @relation(fields: [cityId], references: [id])
  examBoard        ExamBoard?         @relation(fields: [examBoardId], references: [id])
  jobRoles         CompetitionJobRole[]
  subjects         CompetitionSubject[]
  jobRoleSubjects  CompetitionJobRoleSubject[]
  stages           CompetitionStage[]
  students         StudentCompetition[]
  preferredByStudents StudentProfile[] @relation("StudentPreferredCompetition")
  questions        Question[]
  planCompetitions PlanCompetition[]
  pdfImports       PDFImport[]
  simulatedExams   SimulatedExam[]
  apostilas        Apostila[]
  importedQuestionRows ImportedQuestion[]

  @@map("competitions")
}

enum CompetitionStatus {
  UPCOMING
  ACTIVE
  PAST
  CANCELLED
}

model CompetitionJobRole {
  competitionId String
  jobRoleId     String

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  jobRole     JobRole     @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@id([competitionId, jobRoleId])
  @@map("competition_job_roles")
}

// ============================================================
// MATÉRIAS E ASSUNTOS
// ============================================================

model Subject {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics              Topic[]
  competitions        CompetitionSubject[]
  competitionJobRoles CompetitionJobRoleSubject[]
  questions           Question[]
  jobRoles            JobRoleSubject[]
  aiMetas             QuestionAiMeta[]

  @@map("subjects")
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  slug      String
  subjectId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]
  aiMetas   QuestionAiMeta[]

  @@unique([slug, subjectId])
  @@map("topics")
}

model CompetitionSubject {
  competitionId  String
  subjectId      String
  weight         Float?
  questionsCount Int?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([competitionId, subjectId])
  @@map("competition_subjects")
}

model JobRoleSubject {
  jobRoleId String
  subjectId String
  priority  Int    @default(1)

  jobRole JobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([jobRoleId, subjectId])
  @@map("job_role_subjects")
}

/// Vínculo 3 vias: cargo específico de um concurso + matéria desse cargo
model CompetitionJobRoleSubject {
  id            String @id @default(cuid())
  competitionId String
  jobRoleId     String
  subjectId     String

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  jobRole     JobRole     @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([competitionId, jobRoleId, subjectId])
  @@map("competition_job_role_subjects")
}

/// Etapas/fases de um concurso (prova objetiva, TAF, investigação social, etc.)
model CompetitionStage {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  order         Int      @default(0)
  description   String?
  createdAt     DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@map("competition_stages")
}

// ============================================================
// RELAÇÃO ALUNO-CONCURSO
// ============================================================

model StudentCompetition {
  id               String   @id @default(cuid())
  studentProfileId String
  competitionId    String
  jobRoleId        String?
  enrolledAt       DateTime @default(now())
  isActive         Boolean  @default(true)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  competition    Competition    @relation(fields: [competitionId], references: [id])
  jobRole        JobRole?       @relation(fields: [jobRoleId], references: [id])

  @@unique([studentProfileId, competitionId])
  @@map("student_competitions")
}

// ============================================================
// BANCO DE QUESTÕES
// ============================================================

model Question {
  id             String         @id @default(cuid())
  /// Código legível e estável (ex: DQ001). Gerado automaticamente.
  code           String?        @unique
  content        String         @db.Text
  /// Texto de apoio compartilhado (artigo, trecho comum a várias questões), separado do enunciado
  supportText    String?        @db.Text
  correctAnswer  String
  subjectId      String?
  topicId        String?
  examBoardId    String?
  competitionId  String?
  cityId         String?
  jobRoleId      String?
  year           Int?
  difficulty     Difficulty     @default(MEDIUM)
  tags           String[]       @default([])
  hasImage       Boolean        @default(false)
  imageUrl       String?        @db.Text
  rawText        String?        @db.Text
  sourceDocument String?
  sourcePage     Int?
  sourcePosition Int?
  status         QuestionStatus @default(ACTIVE)
  importId       String?
  confidence     Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  subject      Subject?    @relation(fields: [subjectId], references: [id])
  topic        Topic?      @relation(fields: [topicId], references: [id])
  examBoard    ExamBoard?  @relation(fields: [examBoardId], references: [id])
  competition  Competition? @relation(fields: [competitionId], references: [id])
  city         City?       @relation(fields: [cityId], references: [id])
  jobRole      JobRole?    @relation(fields: [jobRoleId], references: [id])
  pdfImport    PDFImport?  @relation(fields: [importId], references: [id])
  aiMeta       QuestionAiMeta?

  isMarkedSuspect  Boolean @default(false)

  alternatives      Alternative[]
  studentAnswers    StudentAnswer[]
  trainingSessionQuestions TrainingSessionQuestion[]
  examQuestions     SimulatedExamQuestion[]
  apostilaQuestions ApostilaQuestion[]
  usedBy            UsedQuestion[]
  questionReports   QuestionReport[]
  revisions        QuestionRevision[]
  aiUsageLogs      AiUsageLog[]

  @@map("questions")
}

/// Sequenciador simples para códigos de questões (DQ001, DQ002, ...).
/// Mantém geração atômica via transação no Postgres.
model QuestionCodeSeq {
  id   Int @id @default(1)
  next Int

  @@map("question_code_seq")
}

model QuestionAiMeta {
  id                 String   @id @default(cuid())
  questionId          String   @unique
  suggestedSubjectId  String?
  suggestedTopicId    String?
  suggestedExamBoardId String?
  suggestedCityId     String?
  suggestedJobRoleId  String?
  suggestedYear       Int?
  confidence          Float?
  reasoning           String?  @db.Text
  raw                Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  subject    Subject?  @relation(fields: [suggestedSubjectId], references: [id])
  topic      Topic?    @relation(fields: [suggestedTopicId], references: [id])
  examBoard  ExamBoard? @relation(fields: [suggestedExamBoardId], references: [id])
  city       City?     @relation(fields: [suggestedCityId], references: [id])
  jobRole    JobRole?  @relation(fields: [suggestedJobRoleId], references: [id])

  @@map("question_ai_meta")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
}

model Alternative {
  id         String  @id @default(cuid())
  questionId String
  letter     String
  content    String  @db.Text
  imageUrl   String? @db.Text
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, letter])
  @@map("alternatives")
}

// ============================================================
// RESPOSTAS DO ALUNO
// ============================================================

model StudentAnswer {
  id               String      @id @default(cuid())
  studentProfileId String
  questionId       String
  selectedAnswer   String
  isCorrect        Boolean
  /// Explicação curta (IA) do porquê a resposta do aluno estava incorreta
  aiExplanation    String?     @db.Text
  timeSpentSeconds Int?
  answeredAt       DateTime    @default(now())
  sessionType      SessionType
  sessionId        String?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id])

  @@map("student_answers")
}

enum SessionType {
  TRAINING
  EXAM
  REVIEW
  MANUAL
}

// ============================================================
// SESSÕES DE TREINO
// ============================================================

model TrainingSession {
  id               String    @id @default(cuid())
  studentProfileId String
  competitionId    String?
  subjectId        String?
  topicId          String?
  filters          Json?
  totalQuestions   Int       @default(0)
  correctAnswers   Int       @default(0)
  timeSpentSeconds Int       @default(0)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  questions       TrainingSessionQuestion[]

  @@map("training_sessions")
}

model TrainingSessionQuestion {
  id               String   @id @default(cuid())
  trainingSessionId String
  questionId       String
  order            Int
  selectedAnswer   String?
  isCorrect        Boolean?
  replacedAt       DateTime?

  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id])

  @@unique([trainingSessionId, questionId])
  @@index([trainingSessionId, order])
  @@map("training_session_questions")
}

// ============================================================
// SIMULADOS
// ============================================================

model SimulatedExam {
  id                 String     @id @default(cuid())
  studentProfileId   String
  competitionId      String?
  title              String?
  totalQuestions     Int
  correctAnswers     Int        @default(0)
  timeAllowedSeconds Int?
  timeSpentSeconds   Int        @default(0)
  completedAt        DateTime?
  status             ExamStatus @default(IN_PROGRESS)
  createdAt          DateTime   @default(now())

  studentProfile StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  competition    Competition?            @relation(fields: [competitionId], references: [id])
  questions      SimulatedExamQuestion[]

  @@map("simulated_exams")
}

enum ExamStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model SimulatedExamQuestion {
  id               String   @id @default(cuid())
  examId           String
  questionId       String
  order            Int
  selectedAnswer   String?
  isCorrect        Boolean?
  timeSpentSeconds Int?

  exam     SimulatedExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question      @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
  @@map("simulated_exam_questions")
}

// ============================================================
// APOSTILAS
// ============================================================

model Apostila {
  id               String   @id @default(cuid())
  studentProfileId String
  competitionId    String?
  title            String
  fileUrl          String?
  generatedAt      DateTime @default(now())

  studentProfile StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  competition    Competition?       @relation(fields: [competitionId], references: [id])
  questions      ApostilaQuestion[]

  @@map("apostilas")
}

model ApostilaQuestion {
  id         String @id @default(cuid())
  apostilaId String
  questionId String
  order      Int

  apostila Apostila @relation(fields: [apostilaId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([apostilaId, questionId])
  @@map("apostila_questions")
}

// ============================================================
// CONTROLE DE QUESTÕES USADAS (anti-repetição)
// ============================================================

model UsedQuestion {
  id               String     @id @default(cuid())
  studentProfileId String
  questionId       String
  usedInType       UsedInType
  usedAt           DateTime   @default(now())
  /// Chave do contexto (concurso/cargo/matérias/banca/dificuldade) para anti-repetição por filtro
  contextKey       String?
  /// Motivo: nova ou repetida por esgotamento do banco no filtro
  reason           UsedQuestionReason @default(NEW)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id])

  @@index([studentProfileId, usedInType, contextKey])
  @@index([studentProfileId, questionId])
  @@map("used_questions")
}

enum UsedInType {
  TRAINING
  EXAM
  APOSTILA
}

enum UsedQuestionReason {
  NEW
  REPEAT_EXHAUSTED
}

// ============================================================
// IMPORTAÇÃO DE PDFs
// ============================================================

model PDFImport {
  id                        String       @id @default(cuid())
  competitionId             String?
  cityId                    String?
  examBoardId               String?
  jobRoleId                 String?
  subjectId                 String?
  year                      Int?
  examDate                  DateTime?
  originalFilename          String
  originalFilenameGabarito  String?
  gabaritoInSamePdf         Boolean      @default(false)
  /// Caminho relativo ao cwd: private/import-pdfs/{id}.pdf (servido só via API admin)
  storedPdfPath             String?
  status                    ImportStatus @default(PENDING)
  totalExtracted            Int          @default(0)
  totalApproved             Int          @default(0)
  totalRejected             Int          @default(0)
  processingLog             String?
  processingError           String?
  createdBy                 String
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  competition       Competition?       @relation(fields: [competitionId], references: [id])
  questions         Question[]
  importedQuestions ImportedQuestion[]
  importAssets      ImportAsset[]

  @@map("pdf_imports")
}

enum ImportStatus {
  PENDING
  PROCESSING
  REVIEW_PENDING
  COMPLETED
  FAILED
}

model ImportedQuestion {
  id                  String                 @id @default(cuid())
  importId            String
  content             String
  alternatives        Json
  correctAnswer       String?
  /// Disciplina (revisão)
  suggestedSubjectId  String?
  /// Assunto (revisão)
  suggestedTopicId    String?
  /// Metadados por questão; null = herdar da importação (PDFImport) na publicação
  year                 Int?
  examBoardId          String?
  competitionId        String?
  cityId               String?
  jobRoleId            String?
  difficulty           Difficulty             @default(MEDIUM)
  tags                 String[]             @default([])
  sourcePage          Int?
  sourcePosition      Int?
  hasImage            Boolean                @default(false)
  imageUrl            String?
  rawText             String?
  confidence          Float?
  status              ImportedQuestionStatus @default(PENDING_REVIEW)
  reviewedBy          String?
  reviewedAt          DateTime?
  publishedQuestionId String?
  createdAt           DateTime               @default(now())

  pdfImport         PDFImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  assetLinks        ImportedQuestionAsset[]
  reviewExamBoard   ExamBoard?    @relation(fields: [examBoardId], references: [id], onDelete: SetNull)
  reviewCompetition Competition?  @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  reviewCity        City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  reviewJobRole     JobRole?      @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)

  @@index([suggestedSubjectId])
  @@index([suggestedTopicId])
  @@index([competitionId])
  @@index([examBoardId])
  @@index([year])
  @@map("imported_questions")
}

/// Região ou elemento visual (texto/imagem) extraído ou marcado manualmente no PDF
model ImportAsset {
  id             String           @id @default(cuid())
  importId       String
  kind           ImportAssetKind
  label          String?
  /// Página 1-based (alinhada ao visualizador)
  page           Int
  /// Bounding box normalizado 0–1 em relação à largura/altura da página renderizada
  bboxX          Float
  bboxY          Float
  bboxW          Float
  bboxH          Float
  scope          ImportAssetScope @default(EXCLUSIVE)
  extractedText  String?          @db.Text
  /// Recorte ou figura em base64 (opcional; prioridade na publicação se vinculado)
  imageDataUrl   String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  pdfImport      PDFImport                 @relation(fields: [importId], references: [id], onDelete: Cascade)
  questionLinks  ImportedQuestionAsset[]

  @@map("import_assets")
}

enum ImportAssetKind {
  TEXT_BLOCK
  IMAGE
}

enum ImportAssetScope {
  EXCLUSIVE
  SHARED
}

/// Vínculo entre uma questão importada e um ativo (texto-base compartilhado, figura, etc.)
/// `alternativeLetter` = "A"…"E" quando o recorte é imagem de alternativa; null = enunciado/apoio/figura principal
model ImportedQuestionAsset {
  id                 String          @id @default(cuid())
  importedQuestionId String
  importAssetId      String
  role               ImportAssetRole
  alternativeLetter  String?

  importedQuestion ImportedQuestion @relation(fields: [importedQuestionId], references: [id], onDelete: Cascade)
  importAsset      ImportAsset      @relation(fields: [importAssetId], references: [id], onDelete: Cascade)

  @@unique([importedQuestionId, importAssetId])
  @@index([importedQuestionId, alternativeLetter])
  @@map("imported_question_assets")
}

enum ImportAssetRole {
  SUPPORT_TEXT
  FIGURE
}

enum ImportedQuestionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

// ============================================================
// DENÚNCIAS DE QUESTÕES
// ============================================================

enum QuestionReportCategory {
  INCOMPLETE_STATEMENT
  MISSING_TEXT
  MISSING_IMAGE
  MISSING_ALTERNATIVE
  FORMAT_ERROR
  WRONG_ANSWER
  AMBIGUOUS_ANSWER
  INCONSISTENT_CONTENT
  OTHER
}

enum QuestionReportStatus {
  PENDING
  AI_REVIEWED
  UNDER_REVIEW
  IN_ANALYSIS
  PROCEDENTE
  IMPROCEDENTE
  RESOLVED
  DISMISSED
}

model QuestionReport {
  id               String                 @id @default(cuid())
  studentProfileId String
  questionId       String
  category         QuestionReportCategory
  description      String?                @db.Text
  /// "during" = durante a prova (só estrutural); "after" = após finalizar
  phase            String
  sessionId        String?
  sessionType      String?
  status           QuestionReportStatus   @default(PENDING)
  adminNote        String?                @db.Text
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  studentProfile StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  question       Question                @relation(fields: [questionId], references: [id], onDelete: Cascade)
  aiReview       QuestionReportAiReview?
  events         QuestionReportEvent[]
  revisions      QuestionRevision[]

  @@map("question_reports")
}

model QuestionReportAiReview {
  id         String   @id @default(cuid())
  reportId   String   @unique
  /// "ANSWER_IS_CORRECT" | "ANSWER_MAY_BE_WRONG" | "ANSWER_IS_WRONG" | "AMBIGUOUS"
  verdict    String
  analysis   String   @db.Text
  confidence Float?
  createdAt  DateTime @default(now())

  report QuestionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("question_report_ai_reviews")
}

/// Auditoria de mudanças de status/ações em denúncias (admin)
model QuestionReportEvent {
  id          String   @id @default(cuid())
  reportId    String
  actorUserId String
  action      String   // ex: "STATUS_CHANGE", "NOTE_UPDATE", "MARK_SUSPECT"
  fromStatus  QuestionReportStatus?
  toStatus    QuestionReportStatus?
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  report QuestionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("question_report_events")
}

/// Auditoria de revisões/edições de uma questão (admin)
model QuestionRevision {
  id          String   @id @default(cuid())
  questionId  String
  reportId    String?
  editedBy    String
  editedAt    DateTime @default(now())
  before      Json
  after       Json

  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  report   QuestionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([questionId, editedAt])
  @@index([reportId])
  @@map("question_revisions")
}

// ============================================================
// TEMA VISUAL / WHITE-LABEL
// ============================================================

model BrandTheme {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#6366f1")
  secondaryColor  String   @default("#8b5cf6")
  accentColor     String   @default("#06b6d4")
  platformName    String
  loginBannerUrl  String?
  footerText      String?
  /// Configurações específicas da tela de login (background, frases, card, etc.)
  loginConfig     Json?
  /// Configurações gerais de UI (botões, raios/bordas, etc.)
  uiConfig        Json?
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("brand_themes")
}

/// Assets de marca armazenados no banco (persistente entre instâncias/deploys)
model BrandAsset {
  id        String   @id @default(cuid())
  /// Nome do arquivo gerado (ex: "a1b2...c3.webp") usado na URL pública
  key       String   @unique
  mimeType  String
  bytes     Bytes
  /// Metadados opcionais (útil para debug/triagem)
  kind      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("brand_assets")
}
